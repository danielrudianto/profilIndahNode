DATABASE_URL="mysql://user:sandi@localhost:3306/nama_database"
TOKEN_KEY="apa-saja-untuk-lokal"
REFRESH_TOKEN_KEY="apa-saja-untuk-lokal"
EXPIRATION="1h"
REFRESH_EXPIRATION="7d"

# Meilisearch — WAJIB, bukan pilihan.
#
# Daftar barang dan daftar stok tidak membaca MySQL sama sekali; keduanya
# mencari lewat indeks "product" di Meilisearch. Bila kuncinya kosong atau
# salah, Meilisearch menolak permintaannya, pencarian melempar, dan kedua
# halaman itu menjawab 500 — padahal basis datanya baik-baik saja. Gejalanya
# menyesatkan justru karena tidak menyebut Meilisearch sama sekali.
#
# Kuncinya harus sama persis dengan yang dipakai menjalankan meilisearch
# (--master-key). Setelah diisi, indeksnya perlu dibuat sekali:
#   npm run start:setup
#   npm run start:sync-product
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_MASTER_KEY="sama-dengan-master-key-meilisearch"

# Redis — antrean BullMQ dan singgahan.
# Boleh REDIS_URL saja, atau pasangan host/port.
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"

# Jumlah baris per halaman yang dikirim server pada daftar arsip.
LIMIT="10"

# Perhitungan stok minimum (reorder point) — opsional, angka di bawah default.
# Jendela riwayat penjualan yang dibaca (hari); toko memakai 30.
MIN_STOCK_WINDOW_DAYS="30"
# Perkiraan lama pesanan sampai dari supplier (hari).
MIN_STOCK_LEAD_DAYS="7"
# Nilai z tingkat layanan; 1.65 kira-kira 95%.
MIN_STOCK_SERVICE_Z="1.65"
