{
  "name": "profil_indah_node",
  "version": "2.2.0",
  "description": "Backend Node Typescript for Toko Profil Indah project",
  "main": "index.js",
  "scripts": {
    "start": "nodemon src/app.ts",
    "pretty": "npx prettier --write \"**/*.ts\"",
    "build": "tsc",
    "start:worker": "npx ts-node src/worker.ts",
    "start:setup": "npx ts-node src/setup/meilisearch.setup.ts",
    "start:setup-database": "npx ts-node src/startup.ts setupDatabase",
    "start:sync-product": "npx ts-node src/startup.ts syncProduct",
    "start:sync-package": "npx ts-node src/startup.ts syncProductPackage",
    "start:sync-sales": "npx ts-node src/startup.ts syncSales",
    "start:insert-hpp": "npx ts-node src/startup.ts insertStockInOut",
    "start:insert-stock-out": "npx ts-node src/startup.ts insertStockOut",
    "start:calculate-hpp": "npx ts-node src/startup.ts calculateStockOut",
    "start:calculate-card": "npx ts-node src/startup.ts insertStockCard",
    "start:order-card": "npx ts-node src/startup.ts orderStockCard",
    "start:update-product-stock": "npx ts-node src/startup.ts updateProductStock",
    "pretest": "prisma generate",
    "test": "jest",
    "check": "node scripts/check-route-guards.js; node scripts/check-sql-injection.js"
  },
  "author": "PT Terra Nusa Teknologi",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^4.16.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.5.0",
    "express": "^4.22.2",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "meilisearch": "^0.31.1",
    "moment": "^2.29.4",
    "node-cron": "^4.6.0",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ptkdev/logger": "^1.8.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.1",
    "express-validator": "^7.3.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^2.7.1",
    "prisma": "^4.16.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.1",
    "typescript": "^6.0.3"
  }
}
