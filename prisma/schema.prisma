datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model payment_method {
  id                                   Int         @id @default(autoincrement())
  name                                 String      @db.VarChar(100)
  description                          String      @db.Text
  created_by                           Int
  created_at                           DateTime    @default(now()) @db.DateTime(0)
  is_delete                            Boolean     @default(false)
  deleted_by                           Int?
  deleted_at                           DateTime?   @db.DateTime(0)
  user_payment_method_created_byTouser user        @relation("payment_method_created_byTouser", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "payment_method_ibfk_1")
  user_payment_method_deleted_byTouser user?       @relation("payment_method_deleted_byTouser", fields: [deleted_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "payment_method_ibfk_2")
  bill_code                            bill_code[]

  @@index([created_by], map: "payment_method_ibfk_1_idx")
  @@index([deleted_by], map: "payment_method_ibfk_2_idx")
}

model user {
  id                                                       Int                   @id @default(autoincrement())
  name                                                     String                @db.VarChar(45)
  nik                                                      String                @unique(map: "nik_UNIQUE") @db.VarChar(45)
  username                                                 String                @unique(map: "username_UNIQUE") @db.VarChar(45)
  password                                                 String                @db.VarChar(100)
  created_by                                               Int?
  created_at                                               DateTime              @default(now()) @db.DateTime(0)
  is_active                                                Boolean               @default(true)
  is_admin                                                 Boolean?              @default(false)
  user                                                     user?                 @relation("userTouser_created_by", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_ibfk_1")
  bill_code_bill_code_confirmed_byTouser                   bill_code[]           @relation("bill_code_confirmed_byTouser")
  bill_code_bill_code_created_byTouser                     bill_code[]           @relation("bill_code_created_byTouser")
  company_company_created_byTouser                         company[]             @relation("company_created_byTouser")
  company_company_deleted_byTouser                         company[]             @relation("company_deleted_byTouser")
  customer_customer_created_byTouser                       customer[]            @relation("customer_created_byTouser")
  customer_customer_deleted_byTouser                       customer[]            @relation("customer_deleted_byTouser")
  expense_expense_created_byTouser                         expense[]             @relation("expense_created_byTouser")
  expense_expense_deleted_byTouser                         expense[]             @relation("expense_deleted_byTouser")
  expense_type                                             expense_type[]
  good_receipt_code_good_receipt_code_confirmed_byTouser   good_receipt_code[]   @relation("good_receipt_code_confirmed_byTouser")
  good_receipt_code_good_receipt_code_created_byTouser     good_receipt_code[]   @relation("good_receipt_code_created_byTouser")
  item_item_created_byTouser                               item[]                @relation("item_created_byTouser")
  item_item_deleted_byTouser                               item[]                @relation("item_deleted_byTouser")
  item_brand_item_brand_created_byTouser                   item_brand[]          @relation("item_brand_created_byTouser")
  item_brand_item_brand_deleted_byTouser                   item_brand[]          @relation("item_brand_deleted_byTouser")
  item_price_item_price_created_byTouser                   item_price[]          @relation("item_price_created_byTouser")
  item_price_item_price_deleted_byTouser                   item_price[]          @relation("item_price_deleted_byTouser")
  item_price_purchase_item_price_purchase_created_byTouser item_price_purchase[] @relation("item_price_purchase_created_byTouser")
  item_price_purchase_item_price_purchase_deleted_byTouser item_price_purchase[] @relation("item_price_purchase_deleted_byTouser")
  payment_method_payment_method_created_byTouser           payment_method[]      @relation("payment_method_created_byTouser")
  payment_method_payment_method_deleted_byTouser           payment_method[]      @relation("payment_method_deleted_byTouser")
  purchase_invoice_purchase_invoice_confirmed_byTouser     purchase_invoice[]    @relation("purchase_invoice_confirmed_byTouser")
  purchase_invoice_purchase_invoice_created_byTouser       purchase_invoice[]    @relation("purchase_invoice_created_byTouser")
  supplier                                                 supplier[]
  other_user                                               user[]                @relation("userTouser_created_by")
  user_department_userTouser_department_created_by         user_department[]     @relation("userTouser_department_created_by")
  user_department_userTouser_department_user_id            user_department[]     @relation("userTouser_department_user_id")
  user_position_userTouser_position_created_by             user_position[]       @relation("userTouser_position_created_by")
  user_position_userTouser_position_user_id                user_position[]       @relation("userTouser_position_user_id")

  @@index([created_by], map: "user_ibfk_1_idx")
}

model bill {
  id           Int       @id @default(autoincrement())
  item_id      Int
  price        Decimal   @db.Decimal(50, 4)
  discount     Decimal   @db.Decimal(50, 4)
  quantity     Decimal   @db.Decimal(50, 4)
  bill_code_id Int
  bill_code    bill_code @relation(fields: [bill_code_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "bill_ibfk_1")
  item         item      @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "bill_ibfk_2")

  @@index([bill_code_id], map: "bill_ibfk_1_idx")
  @@index([item_id], map: "bill_ibfk_2_idx")
}

model bill_code {
  id                                Int             @id @default(autoincrement())
  name                              String          @unique(map: "name_UNIQUE") @db.VarChar(45)
  customer_id                       Int?
  created_by                        Int
  created_at                        DateTime        @default(now()) @db.DateTime(0)
  payment_method_id                 Int?
  is_delete                         Boolean         @default(false)
  is_confirm                        Boolean         @default(false)
  confirmed_by                      Int?
  confirmed_at                      DateTime?       @db.DateTime(0)
  discount                          Decimal         @default(0.0000) @db.Decimal(50, 4)
  delivery                          Decimal         @default(0.0000) @db.Decimal(50, 4)
  user_bill_code_confirmed_byTouser user?           @relation("bill_code_confirmed_byTouser", fields: [confirmed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "bill_code_ibfk_2")
  user_bill_code_created_byTouser   user            @relation("bill_code_created_byTouser", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "bill_code_ibfk_1")
  customer                          customer?       @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "bill_code_ibfk_3")
  payment_method                    payment_method? @relation(fields: [payment_method_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "bill_code_ibfk_4")
  bill                              bill[]

  @@index([created_by], map: "bill_code_ibfk_1_idx")
  @@index([confirmed_by], map: "bill_code_ibfk_2_idx")
  @@index([customer_id], map: "bill_code_ibfk_3_idx")
  @@index([payment_method_id], map: "bill_code_ibfk_4_idx")
}

model company {
  id                            Int                 @id @default(autoincrement())
  code_name                     String              @db.VarChar(3)
  name                          String              @db.VarChar(50)
  address                       String              @db.Text
  npwp                          String?             @db.VarChar(45)
  created_by                    Int
  created_at                    DateTime            @default(now()) @db.DateTime(0)
  is_delete                     Boolean?            @default(false)
  deleted_by                    Int?
  deleted_at                    DateTime?           @db.DateTime(0)
  user_company_created_byTouser user                @relation("company_created_byTouser", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "company_ibfk_1")
  user_company_deleted_byTouser user?               @relation("company_deleted_byTouser", fields: [deleted_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "company_ibfk_2")
  good_receipt_code             good_receipt_code[]

  @@index([created_by], map: "company_ibfk_1_idx")
  @@index([deleted_by], map: "company_ibfk_2_idx")
}

model customer {
  id                             Int         @id @default(autoincrement())
  name                           String      @db.VarChar(100)
  address                        String      @db.VarChar(500)
  phone_number                   String      @db.VarChar(45)
  pic                            String      @db.VarChar(100)
  npwp                           String?     @db.VarChar(45)
  created_by                     Int
  created_at                     DateTime    @default(now()) @db.DateTime(0)
  is_delete                      Boolean     @default(false)
  deleted_by                     Int?
  deleted_at                     DateTime?   @db.DateTime(0)
  user_customer_created_byTouser user        @relation("customer_created_byTouser", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "customer_ibfk_1")
  user_customer_deleted_byTouser user?       @relation("customer_deleted_byTouser", fields: [deleted_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "customer_ibfk_2")
  bill_code                      bill_code[]

  @@index([name, address, pic, phone_number, npwp], map: "customer_fulltext")
  @@index([created_by], map: "customer_ibfk_1_idx")
  @@index([deleted_by], map: "customer_ibfk_2_idx")
}

model expense {
  id                            Int          @id @default(autoincrement())
  date                          DateTime     @db.Date
  description                   String       @db.Text
  value                         Decimal      @db.Decimal(50, 4)
  created_by                    Int
  created_at                    DateTime     @default(now()) @db.DateTime(0)
  is_delete                     Boolean      @default(false)
  deleted_by                    Int?
  deleted_at                    DateTime?    @db.DateTime(0)
  expense_type_id               Int
  user_expense_created_byTouser user         @relation("expense_created_byTouser", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "expense_ibfk_1")
  user_expense_deleted_byTouser user?        @relation("expense_deleted_byTouser", fields: [deleted_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "expense_ibfk_2")
  expense_type                  expense_type @relation(fields: [expense_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "expense_ibfk_3")

  @@index([created_by], map: "expense_ibfk_1_idx")
  @@index([deleted_by], map: "expense_ibfk_2_idx")
  @@index([expense_type_id], map: "expense_ibfk_3_idx")
}

model expense_type {
  id                 Int            @id @default(autoincrement())
  name               String         @db.VarChar(100)
  description        String         @db.Text
  parent_id          Int?
  created_by         Int
  created_at         DateTime       @default(now()) @db.DateTime(0)
  user               user           @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "expense_type_ibfk_1")
  expense_type       expense_type?  @relation("expense_typeToexpense_type_parent_id", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "expense_type_ibfk_2")
  expense            expense[]
  other_expense_type expense_type[] @relation("expense_typeToexpense_type_parent_id")

  @@index([created_by], map: "expense_type_ibfk_1_idx")
  @@index([parent_id], map: "expense_type_ibfk_2_idx")
}

model good_receipt {
  id                   Int               @id @default(autoincrement())
  item_id              Int
  quantity             Decimal           @db.Decimal(50, 4)
  good_receipt_code_id Int
  price                Decimal           @db.Decimal(50, 4)
  good_receipt_code    good_receipt_code @relation(fields: [good_receipt_code_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "good_receipt_ibfk_1")
  item                 item              @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "good_receipt_ibfk_2")

  @@index([good_receipt_code_id], map: "good_receipt_ibfk_1_idx")
  @@index([item_id], map: "good_receipt_ibfk_2")
}

model good_receipt_code {
  id                                        Int                @id @default(autoincrement())
  name                                      String             @db.VarChar(100)
  date                                      DateTime           @db.Date
  created_by                                Int
  created_at                                DateTime           @default(now()) @db.DateTime(0)
  is_confirm                                Boolean            @default(false)
  is_delete                                 Boolean            @default(false)
  confirmed_by                              Int?
  confirmed_at                              DateTime?          @db.DateTime(0)
  supplier_id                               Int
  company_id                                Int
  company                                   company            @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "good_receipt_code_ibfk_4")
  user_good_receipt_code_confirmed_byTouser user?              @relation("good_receipt_code_confirmed_byTouser", fields: [confirmed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "good_receipt_code_ibfk_2")
  user_good_receipt_code_created_byTouser   user               @relation("good_receipt_code_created_byTouser", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "good_receipt_code_ibfk_1")
  supplier                                  supplier           @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "good_receipt_code_ibfk_3")
  good_receipt                              good_receipt[]
  purchase_invoice                          purchase_invoice[]

  @@index([created_by], map: "good_receipt_code_ibfk_1_idx")
  @@index([confirmed_by], map: "good_receipt_code_ibfk_2_idx")
  @@index([supplier_id], map: "good_receipt_code_ibfk_3_idx")
  @@index([company_id], map: "good_receipt_code_ibfk_4_idx")
}

model item {
  id                         Int                   @id @default(autoincrement())
  reference                  String                @db.VarChar(50)
  description                String                @db.VarChar(500)
  minimum_stock              Decimal               @default(0.0000) @db.Decimal(50, 4)
  created_by                 Int
  created_at                 DateTime              @default(now()) @db.DateTime(0)
  is_delete                  Boolean?              @default(false)
  deleted_by                 Int?
  deleted_at                 DateTime?             @db.DateTime(0)
  item_brand_id              Int
  user_item_created_byTouser user                  @relation("item_created_byTouser", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "item_ibfk_1")
  user_item_deleted_byTouser user?                 @relation("item_deleted_byTouser", fields: [deleted_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "item_ibfk_2")
  item_brand                 item_brand            @relation(fields: [item_brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "item_ibfk_3")
  bill                       bill[]
  good_receipt               good_receipt[]
  item_price                 item_price[]
  item_price_purchase        item_price_purchase[]

  @@index([reference, description], map: "item_fulltext")
  @@index([created_by], map: "item_ibfk_1_idx")
  @@index([deleted_by], map: "item_ibfk_2_idx")
  @@index([item_brand_id], map: "item_ibfk_3_idx")
}

model item_brand {
  id                               Int       @id @default(autoincrement())
  name                             String    @unique(map: "name_UNIQUE") @db.VarChar(45)
  created_by                       Int
  created_at                       DateTime  @default(now()) @db.DateTime(0)
  is_delete                        Boolean?  @default(false)
  deleted_by                       Int?
  deleted_at                       DateTime? @db.DateTime(0)
  user_item_brand_created_byTouser user      @relation("item_brand_created_byTouser", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "item_brand_ibfk_1")
  user_item_brand_deleted_byTouser user?     @relation("item_brand_deleted_byTouser", fields: [deleted_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "item_brand_ibfk_2")
  item                             item[]

  @@index([name], map: "item_brand_fulltext")
  @@index([created_by], map: "item_brand_ibfk_1_idx")
  @@index([deleted_by], map: "item_brand_ibfk_2_idx")
}

model item_price {
  id                               Int       @id @default(autoincrement())
  item_id                          Int
  price                            Decimal   @db.Decimal(50, 4)
  discount                         Decimal   @db.Decimal(50, 4)
  discount_project                 Decimal   @db.Decimal(50, 4)
  effective_date                   DateTime  @db.Date
  created_by                       Int
  created_at                       DateTime  @default(now()) @db.DateTime(0)
  is_delete                        Boolean   @default(false)
  deleted_by                       Int?
  deleted_at                       DateTime? @db.DateTime(0)
  user_item_price_created_byTouser user      @relation("item_price_created_byTouser", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "item_price_ibfk_2")
  user_item_price_deleted_byTouser user?     @relation("item_price_deleted_byTouser", fields: [deleted_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "item_price_ibfk_3")
  item                             item      @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "item_price_ibfk_1")

  @@index([item_id], map: "item_price_ibfk_1_idx")
  @@index([created_by], map: "item_price_ibfk_2_idx")
  @@index([deleted_by], map: "item_price_ibfk_4_idx")
}

model item_price_purchase {
  id                                        Int       @id @default(autoincrement())
  item_id                                   Int
  price                                     Decimal   @db.Decimal(50, 4)
  created_by                                Int
  created_at                                DateTime  @default(now()) @db.DateTime(0)
  is_delete                                 Boolean   @default(false)
  deleted_by                                Int?
  deleted_at                                DateTime? @db.DateTime(0)
  user_item_price_purchase_created_byTouser user      @relation("item_price_purchase_created_byTouser", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "item_price_purchase_ibfk_2")
  user_item_price_purchase_deleted_byTouser user?     @relation("item_price_purchase_deleted_byTouser", fields: [deleted_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "item_price_purchase_ibfk_3")
  item                                      item      @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "item_price_purchase_ibfk_1")

  @@index([item_id], map: "item_price_purchase_ibfk_1")
  @@index([created_by], map: "item_price_purchase_ibfk_2")
  @@index([deleted_by], map: "item_price_purchase_ibfk_3_idx")
}

model purchase_invoice {
  id                                       Int               @id @default(autoincrement())
  name                                     String?           @db.VarChar(45)
  date                                     DateTime?         @db.Date
  discount                                 Decimal?          @default(0.0000) @db.Decimal(50, 4)
  good_receipt_code_id                     Int
  created_by                               Int
  created_at                               DateTime          @default(now()) @db.DateTime(0)
  is_delete                                Boolean           @default(false)
  is_confirm                               Boolean           @default(false)
  confirmed_by                             Int?
  confirmed_at                             DateTime?         @db.DateTime(0)
  user_purchase_invoice_confirmed_byTouser user?             @relation("purchase_invoice_confirmed_byTouser", fields: [confirmed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "purchase_invoice_ibfk_3")
  user_purchase_invoice_created_byTouser   user              @relation("purchase_invoice_created_byTouser", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "purchase_invoice_ibfk_1")
  good_receipt_code                        good_receipt_code @relation(fields: [good_receipt_code_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "purchase_invoice_ibfk_2")

  @@index([created_by], map: "purchase_invoice_ibfk_1_idx")
  @@index([good_receipt_code_id], map: "purchase_invoice_ibfk_2_idx")
  @@index([confirmed_by], map: "purchase_invoice_ibfk_3_idx")
}

model supplier {
  id                Int                 @id @default(autoincrement())
  name              String              @db.VarChar(100)
  npwp              String?             @db.VarChar(45)
  address           String?             @db.Text
  created_by        Int
  created_at        DateTime?           @default(now()) @db.DateTime(0)
  is_delete         Boolean?            @default(false)
  deleted_by        Int?
  deleted_at        DateTime?           @db.DateTime(0)
  user              user                @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "supplier_ibfk_1")
  good_receipt_code good_receipt_code[]

  @@index([created_by], map: "supplier_ibfk_1_idx")
}

model user_department {
  id                                    Int      @id @default(autoincrement())
  departments                           Int?
  user_id                               Int?
  is_delete                             Boolean? @default(true)
  created_by                            Int?
  user_userTouser_department_created_by user?    @relation("userTouser_department_created_by", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_department_ibfk_2")
  user_userTouser_department_user_id    user?    @relation("userTouser_department_user_id", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_department_ibfk_1")

  @@index([user_id], map: "user_department_ibfk_1_idx")
  @@index([created_by], map: "user_department_ibfk_2_idx")
}

model user_position {
  id                                  Int      @id @default(autoincrement())
  user_id                             Int
  name                                String?  @db.VarChar(45)
  position                            Int
  created_by                          Int
  created_at                          DateTime @default(now()) @db.DateTime(0)
  user_userTouser_position_created_by user     @relation("userTouser_position_created_by", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_position_ibfk_2")
  user_userTouser_position_user_id    user     @relation("userTouser_position_user_id", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_position_ibfk_1")

  @@index([user_id], map: "user_position_ibfk_1_idx")
  @@index([created_by], map: "user_position_ibfk_2_idx")
}
