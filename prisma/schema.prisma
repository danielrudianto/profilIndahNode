generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model payment_method {
  id                                   Int                     @id @default(autoincrement())
  name                                 String                  @db.VarChar(100)
  description                          String                  @db.Text
  created_by                           Int
  created_at                           DateTime                @default(now()) @db.DateTime(0)
  updated_at                           DateTime?               @db.DateTime(0)
  updated_by                           Int?
  is_delete                            Boolean                 @default(false)
  deleted_by                           Int?
  deleted_at                           DateTime?               @db.DateTime(0)
  user                                 user                    @relation("payment_method_created_byTouser", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "payment_method_ibfk_1")
  user_payment_method_deleted_byTouser user?                   @relation("payment_method_deleted_byTouser", fields: [deleted_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "payment_method_ibfk_2")
  user_payment_method_updated_byTouser user?                   @relation("payment_method_updated_byTouser", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "payment_method_ibfk_3")
  sales_return_code                    sales_return_code[]
  sales_invoice_payment                sales_invoice_payment[]
  sales_deposit_payment                sales_deposit_payment[]
  overpayment                          overpayment[]
  sales_invoice_rebate                 sales_invoice_rebate[]

  @@index([created_by], map: "payment_method_ibfk_1_idx")
  @@index([deleted_by], map: "payment_method_ibfk_2_idx")
  @@index([updated_by], map: "payment_method_ibfk_3_idx")
}

model user {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(45)
  nik        String    @unique(map: "nik_UNIQUE") @db.VarChar(45)
  username   String    @unique(map: "username_UNIQUE") @db.VarChar(45)
  password   String    @db.VarChar(100)
  created_by Int?
  created_at DateTime  @default(now()) @db.DateTime(0)
  is_active  Boolean   @default(true)
  updated_by Int?
  updated_at DateTime? @db.DateTime(0)
  deleted_by Int?
  deleted_at DateTime? @db.DateTime(0)
  role       Int

  audit_log                                                    audit_log[]
  user                                                         user?                  @relation("userTouser_created_by", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_ibfk_1")
  user_userTouser_deleted_by                                   user?                  @relation("userTouser_deleted_by", fields: [deleted_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_ibfk_2")
  adjustment_case_code_adjustment_case_code_confirmed_byTouser adjustment_case_code[] @relation("adjustment_case_code_confirmed_byTouser")
  adjustment_case_code_adjustment_case_code_created_byTouser   adjustment_case_code[] @relation("adjustment_case_code_created_byTouser")
  bill_code_bill_code_confirmed_byTouser                       sales_invoice_code[]   @relation("bill_code_confirmed_byTouser")
  bill_code_bill_code_created_byTouser                         sales_invoice_code[]   @relation("bill_code_created_byTouser")
  company_company_created_byTouser                             company[]              @relation("company_created_byTouser")
  company_company_deleted_byTouser                             company[]              @relation("company_deleted_byTouser")
  company_company_updated_byTouser                             company[]              @relation("company_updated_byTouser")
  customer_customer_created_byTouser                           customer[]             @relation("customer_created_byTouser")
  customer_customer_deleted_byTouser                           customer[]             @relation("customer_deleted_byTouser")
  customer_customer_updated_byTouser                           customer[]             @relation("customer_updated_byTouser")
  expense_type_expense_type_updated_byTouser                   expense_type[]         @relation("expense_type_updated_byTouser")
  expense_expense_created_byTouser                             expense[]              @relation("expense_created_byTouser")
  expense_expense_deleted_byTouser                             expense[]              @relation("expense_deleted_byTouser")
  expense_type                                                 expense_type[]
  expense_type_expense_type_deleted_byTouser                   expense_type[]         @relation("expense_type_deleted_byTouser")
  good_receipt_code_good_receipt_code_confirmed_byTouser       good_receipt_code[]    @relation("good_receipt_code_confirmed_byTouser")
  good_receipt_code_good_receipt_code_created_byTouser         good_receipt_code[]    @relation("good_receipt_code_created_byTouser")
  item_item_created_byTouser                                   product[]              @relation("item_created_byTouser")
  item_item_deleted_byTouser                                   product[]              @relation("item_deleted_byTouser")
  item_item_updated_byTouser                                   product[]              @relation("item_updated_byTouser")
  item_brand_item_brand_created_byTouser                       product_brand[]        @relation("item_brand_created_byTouser")
  item_brand_item_brand_deleted_byTouser                       product_brand[]        @relation("item_brand_deleted_byTouser")
  item_brand_item_brand_updated_byTouser                       product_brand[]        @relation("item_brand_updated_byTouser")
  item_type_item_type_created_byTouser                         product_type[]         @relation("item_type_created_byTouser")
  item_type_item_type_deleted_byTouser                         product_type[]         @relation("item_type_deleted_byTouser")
  item_unit                                                    product_unit[]
  item_unit_item_unit_deleted_byTouser                         product_unit[]         @relation("item_unit_deleted_byTouser")
  payment_method_payment_method_created_byTouser               payment_method[]       @relation("payment_method_created_byTouser")
  payment_method_payment_method_deleted_byTouser               payment_method[]       @relation("payment_method_deleted_byTouser")
  payment_method_payment_method_updated_byTouser               payment_method[]       @relation("payment_method_updated_byTouser")
  sales_return_code_sales_return_code_created_byTouser         sales_return_code[]    @relation("sales_return_code_created_byTouser")
  sales_return_code_sales_return_code_deleted_byTouser         sales_return_code[]    @relation("sales_return_code_deleted_byTouser")
  supplier                                                     supplier[]
  supplier_supplier_deleted_byTouser                           supplier[]             @relation("supplier_deleted_byTouser")
  supplier_supplier_updated_byTouser                           supplier[]             @relation("supplier_updated_byTouser")
  other_user                                                   user[]                 @relation("userTouser_created_by")
  other_user_userTouser_deleted_by                             user[]                 @relation("userTouser_deleted_by")
  draft_bill_draft_bill_created_byTouser                       draft_bill_code[]      @relation("draft_bill_created_byTouser")
  draft_bill_draft_bill_confirmed_byTouser                     draft_bill_code[]      @relation("draft_bill_confirmed_byTouser")
  package_code_created_byTouser                                package_code[]         @relation("package_code_created_byTouser")
  package_code_deleted_byTouser                                package_code[]         @relation("package_code_deleted_byTouser")
  promotion_code_created_by                                    promotion_code[]       @relation("promotion_code_created_byTouser")
  promotion_code_deleted_by                                    promotion_code[]       @relation("promotion_code_deleted_byTouser")
  promotion_code_updated_by                                    promotion_code[]       @relation("promotion_code_updated_byTouser")
  user_sales                                                   user_sales[]
  sales_deposit_code_created_by                                sales_deposit_code[]   @relation("deposit_code_created_byTouser")
  sales_deposit_code_deleted_by                                sales_deposit_code[]   @relation("deposit_code_deleted_byTouser")
  sales_deposit_code                                           sales_deposit_code[]
  user_avatar                                                  user_avatar?
  notification                                                 notification[]
  overpayment                                                  overpayment[]
  sales_invoice_rebate                            sales_invoice_rebate[]

  @@index([created_by], map: "user_ibfk_1_idx")
  @@index([deleted_by], map: "user_ibfk_2_idx")
}

model user_avatar {
  id          Int     @id @default(autoincrement())
  user_id     Int     @unique()
  top         Int?
  accessories Int?
  clothes     Int?
  eyes        Int?
  eyebrows    Int?
  mouth       Int?
  color       String  @db.VarChar(45)
  circle      Boolean
  user        user    @relation(fields: [user_id], references: [id])

  @@index([user_id], map: "user_avatar_user")
}

model user_sales {
  id              Int @id @default(autoincrement())
  user_id         Int
  product_type_id Int

  product_type product_type @relation(fields: [product_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_sales_ibfk_2")
  user         user         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_sales_ibfk_1")
}

model sales_invoice {
  id                    Int                @id @default(autoincrement())
  product_id            Int?
  product_unit_id       Int?
  price                 Decimal            @db.Decimal(50, 4)
  discount              Decimal            @db.Decimal(50, 4)
  quantity              Decimal            @db.Decimal(50, 4)
  sales_invoice_code_id Int
  sales_invoice_code    sales_invoice_code @relation(fields: [sales_invoice_code_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "bill_ibfk_1")
  product               product?           @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "bill_ibfk_2")
  product_unit          product_unit?      @relation(fields: [product_unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "bill_ibfk_3")
  sales_return          sales_return[]
  stock_out             stock_out[]
  stock_card            stock_card[]

  @@index([sales_invoice_code_id], map: "sales_invoice_ibfk_1_idx")
  @@index([product_unit_id], map: "sales_invoice_ibfk_3_idx")
  @@index([product_id], map: "item_id")
}

model sales_invoice_code {
  id           Int       @id @default(autoincrement())
  name         String    @unique(map: "name_UNIQUE") @db.VarChar(45)
  customer_id  Int?
  created_by   Int
  created_at   DateTime  @default(now()) @db.DateTime(0)
  is_delete    Boolean   @default(false)
  is_confirm   Boolean   @default(false)
  confirmed_by Int?
  confirmed_at DateTime? @db.DateTime(0)
  discount     Decimal   @default(0.0000) @db.Decimal(50, 4)
  delivery     Decimal   @default(0.0000) @db.Decimal(50, 4)
  service      Decimal   @default(0.0000) @db.Decimal(50, 4)
  // Jenis jasa; NULL berarti faktur ini memang tidak menagih jasa, ATAU
  // faktur lama yang tercatat sebelum kolomnya ada. Lihat service-type.constant.ts.
  service_type String?   @db.VarChar(20)
  uuid         String    @unique(map: "uuid_UNIQUE") @db.VarChar(45)
  payment_term Int?
  is_paid      Boolean   @default(false)
  sales        String?

  date                              DateTime?               @db.Date
  user_bill_code_confirmed_byTouser user?                   @relation("bill_code_confirmed_byTouser", fields: [confirmed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "bill_code_ibfk_2")
  user_bill_code_created_byTouser   user                    @relation("bill_code_created_byTouser", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "bill_code_ibfk_1")
  customer                          customer?               @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "bill_code_ibfk_3")
  sales_invoice                     sales_invoice[]
  sales_invoice_payment             sales_invoice_payment[]
  stock_out                         stock_out[]
  stock_card                        stock_card[]
  sales_return_code                 sales_return_code[]
  // Sisi balik deposit_code_ibfk_4. Berbentuk larik karena Prisma mewajibkannya
  // pada relasi tanpa batasan unik, tetapi isinya paling banyak satu: sebuah
  // setoran hanya dikonfirmasi sekali.
  sales_deposit_code                sales_deposit_code[]
  sales_invoice_rebate              sales_invoice_rebate[]

  @@index([created_by], map: "bill_code_ibfk_1_idx")
  @@index([confirmed_by], map: "bill_code_ibfk_2_idx")
  @@index([customer_id], map: "bill_code_ibfk_3_idx")
}

model sales_invoice_payment {
  id                    Int      @id @default(autoincrement())
  payment_method_id     Int?
  sales_invoice_code_id Int
  value                 Decimal  @default(0.0000) @db.Decimal(15, 4)
  date                  DateTime @db.Date

  sales_invoice_code sales_invoice_code @relation(fields: [sales_invoice_code_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "bill_payment_ibfk_2")
  payment_method     payment_method?    @relation(fields: [payment_method_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "bill_payment_ibfk_1")
}

model sales_deposit {
  id                    Int                @id @default(autoincrement())
  product_id            Int?
  product_unit_id       Int?
  price                 Decimal            @db.Decimal(50, 4)
  discount              Decimal            @db.Decimal(50, 4)
  quantity              Decimal            @db.Decimal(50, 4)
  sales_deposit_code_id Int
  sales_deposit_code    sales_deposit_code @relation(fields: [sales_deposit_code_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "deposit_ibfk_1")
  product               product?           @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "deposit_ibfk_2")
  product_unit          product_unit?      @relation(fields: [product_unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "deposit_ibfk_3")
  is_delete             Boolean            @default(false)

  @@index([sales_deposit_code_id], map: "deposit_ibfk_1_idx")
  @@index([product_unit_id], map: "deposit_ibfk_3_idx")
  @@index([product_id], map: "product_id")
}

model sales_deposit_code {
  id          Int       @id @default(autoincrement())
  name        String    @unique(map: "name_UNIQUE") @db.VarChar(45)
  customer_id Int?
  created_by  Int
  created_at  DateTime  @default(now()) @db.DateTime(0)
  is_delete   Boolean   @default(false)
  deleted_by  Int?
  deleted_at  DateTime? @db.DateTime(0)
  discount    Decimal   @default(0.0000) @db.Decimal(50, 4)
  delivery    Decimal   @default(0.0000) @db.Decimal(50, 4)
  service     Decimal   @default(0.0000) @db.Decimal(50, 4)
  // Ikut faktur yang lahir dari setoran ini; lihat service-type.constant.ts.
  service_type String?  @db.VarChar(20)
  uuid        String    @unique(map: "uuid_UNIQUE") @db.VarChar(45)
  type        String    @default("EXTERNAL") @db.VarChar(8) // INTERNAL, EXTERNAL
  // Sales string but optional, default NULL
  sales       String?

  // Faktur yang lahir dari setoran ini. Sebelumnya kaitannya hanya tersirat
  // lewat penomoran: fakturnya sengaja diberi nomor berawalan DPS- supaya
  // ketahuan asalnya dari setoran. Cara itu membuat penomoran faktur tidak
  // berurutan dan menaruh dua dokumen berbeda pada ruang nomor yang sama,
  // jadi kaitannya kini dinyatakan lewat kolom ini dan fakturnya kembali
  // memakai penomoran faktur biasa.
  //
  // Boleh NULL karena setoran yang belum dikonfirmasi belum punya faktur, dan
  // karena seluruh setoran lama tidak akan terisi surut — kaitannya di sana
  // tetap hanya lewat nomor DPS- yang telanjur beredar.
  sales_invoice_code_id Int?

  date                              DateTime?               @db.Date
  sales_invoice_code                sales_invoice_code?     @relation(fields: [sales_invoice_code_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "deposit_code_ibfk_4")
  user_bill_code_confirmed_byTouser user?                   @relation("deposit_code_deleted_byTouser", fields: [deleted_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "deposit_code_ibfk_2")
  user_bill_code_created_byTouser   user                    @relation("deposit_code_created_byTouser", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "deposit_code_ibfk_1")
  customer                          customer?               @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "deposit_code_ibfk_3")
  sales_deposit                     sales_deposit[]
  sales_deposit_payment             sales_deposit_payment[]
  user                              user?                   @relation(fields: [created_by], references: [id])
  overpayment                       overpayment[]

  @@index([created_by], map: "deposit_code_ibfk_1_idx")
  @@index([deleted_by], map: "deposit_code_ibfk_2_idx")
  @@index([customer_id], map: "deposit_code_ibfk_3_idx")
  @@index([sales_invoice_code_id], map: "deposit_code_ibfk_4_idx")
}

model sales_deposit_payment {
  id                    Int      @id @default(autoincrement())
  payment_method_id     Int?
  sales_deposit_code_id Int
  value                 Decimal  @default(0.0000) @db.Decimal(12, 4)
  date                  DateTime @db.Date

  payment_method     payment_method?    @relation(fields: [payment_method_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "deposit_payment_ibfk_1")
  sales_deposit_code sales_deposit_code @relation(fields: [sales_deposit_code_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "deposit_payment_ibfk_2")
}

model company {
  id                            Int                    @id @default(autoincrement())
  name                          String                 @db.VarChar(50)
  address                       String                 @db.Text
  npwp                          String?                @db.VarChar(45)
  created_by                    Int
  created_at                    DateTime               @default(now()) @db.DateTime(0)
  is_delete                     Boolean?               @default(false)
  deleted_by                    Int?
  deleted_at                    DateTime?              @db.DateTime(0)
  updated_by                    Int?
  updated_at                    DateTime?              @db.DateTime(0)
  expense                       expense[]
  user                          user                   @relation("company_created_byTouser", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "company_ibfk_1")
  user_company_deleted_byTouser user?                  @relation("company_deleted_byTouser", fields: [deleted_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "company_ibfk_2")
  user_company_updated_byTouser user?                  @relation("company_updated_byTouser", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "company_ibfk_3")
  adjustment_case_code          adjustment_case_code[]
  good_receipt_code             good_receipt_code[]
  stock_in                      stock_in[]

  @@index([created_by], map: "company_ibfk_1_idx")
  @@index([deleted_by], map: "company_ibfk_2_idx")
  @@index([updated_by], map: "company_ibfk_3_idx")
}

model customer {
  id                             Int                  @id @default(autoincrement())
  name                           String               @db.VarChar(100)
  address                        String               @db.VarChar(191)
  phone_number                   String               @db.VarChar(45)
  pic                            String               @db.VarChar(100)
  npwp                           String?              @db.VarChar(45)
  created_by                     Int
  created_at                     DateTime             @default(now()) @db.DateTime(0)
  is_delete                      Boolean              @default(false)
  deleted_by                     Int?
  deleted_at                     DateTime?            @db.DateTime(0)
  updated_by                     Int?
  updated_at                     DateTime?            @db.DateTime(0)
  user                           user                 @relation("customer_created_byTouser", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "customer_ibfk_1")
  user_customer_deleted_byTouser user?                @relation("customer_deleted_byTouser", fields: [deleted_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "customer_ibfk_2")
  user_customer_updated_byTouser user?                @relation("customer_updated_byTouser", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "customer_ibfk_3")
  sales_invoice_code             sales_invoice_code[]
  draft_bill_code                draft_bill_code[]
  sales_deposit_code             sales_deposit_code[]
  stock_card                     stock_card[]
  overpayment                    overpayment[]

  @@index([name, address, pic, phone_number, npwp], map: "customer_fulltext")
  @@index([created_by], map: "customer_ibfk_1_idx")
  @@index([deleted_by], map: "customer_ibfk_2_idx")
  @@index([updated_by], map: "customer_ibfk_3_idx")
}

model expense {
  id                            Int          @id @default(autoincrement())
  date                          DateTime     @db.Date
  description                   String       @db.Text
  value                         Decimal      @db.Decimal(50, 4)
  created_by                    Int
  created_at                    DateTime     @default(now()) @db.DateTime(0)
  is_delete                     Boolean      @default(false)
  deleted_by                    Int?
  deleted_at                    DateTime?    @db.DateTime(0)
  expense_type_id               Int
  company_id                    Int
  user_expense_created_byTouser user         @relation("expense_created_byTouser", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "expense_ibfk_1")
  user_expense_deleted_byTouser user?        @relation("expense_deleted_byTouser", fields: [deleted_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "expense_ibfk_2")
  expense_type                  expense_type @relation(fields: [expense_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "expense_ibfk_3")
  company                       company      @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "expense_ibfk_4")

  @@index([created_by], map: "expense_ibfk_1_idx")
  @@index([deleted_by], map: "expense_ibfk_2_idx")
  @@index([expense_type_id], map: "expense_ibfk_3_idx")
}

model expense_type {
  id                                 Int            @id @default(autoincrement())
  name                               String         @db.VarChar(100)
  description                        String         @db.Text
  parent_id                          Int?
  created_by                         Int
  created_at                         DateTime       @default(now()) @db.DateTime(0)
  updated_by                         Int?
  updated_at                         DateTime?      @db.DateTime(0)
  is_delete                          Boolean        @default(false)
  deleted_by                         Int?
  deleted_at                         DateTime?      @db.DateTime(0)
  user                               user           @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "expense_type_ibfk_1")
  user_expense_type_updated_byTouser user?          @relation("expense_type_updated_byTouser", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "expense_type_ibfk_4")
  user_expense_type_deleted_byTouser user?          @relation("expense_type_deleted_byTouser", fields: [deleted_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "expense_type_ibfk_3")
  expense_type                       expense_type?  @relation("expense_typeToexpense_type_parent_id", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "expense_type_ibfk_2")
  expense                            expense[]
  other_expense_type                 expense_type[] @relation("expense_typeToexpense_type_parent_id")

  @@index([created_by], map: "expense_type_ibfk_1_idx")
  @@index([parent_id], map: "expense_type_ibfk_2_idx")
  @@index([deleted_by], map: "expense_type_ibfk_3_idx")
  @@index([updated_by], map: "expense_type_ibfk_4_idx")
}

model good_receipt {
  id                   Int     @id @default(autoincrement())
  product_id           Int
  quantity             Decimal @db.Decimal(12, 2)
  good_receipt_code_id Int
  price                Decimal @db.Decimal(12, 2)
  discount             Decimal @db.Decimal(12, 2)
  product_unit_id      Int?
  is_delete            Boolean @default(false)

  good_receipt_code good_receipt_code @relation(fields: [good_receipt_code_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "good_receipt_ibfk_1")
