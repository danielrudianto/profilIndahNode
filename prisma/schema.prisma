model stock {
  id    Int     @unique
  stock Decimal
  item  item    @relation(fields: [id], references: [id])
}

model stock_card {
  id                 Int      @id
  good_receipt_id    Int?     @unique
  bill_id            Int?     @unique
  adjustment_case_id Int?     @unique
  quantity           Decimal  @db.Decimal(50, 4)
  date               DateTime
  item_id            Int
  stock              Decimal  @db.Decimal(50, 4)
  lead_quantity      Decimal  @db.Decimal(50, 4)
  unit               String?
  conversion         Decimal? @db.Decimal(12, 2)

  item            item             @relation(fields: [item_id], references: [id])
  good_receipt    good_receipt?    @relation(fields: [good_receipt_id], references: [id])
  bill            bill?            @relation(fields: [bill_id], references: [id])
  adjustment_case adjustment_case? @relation(fields: [adjustment_case_id], references: [id])
}

model stock_calculate {
  id                 Int     @id
  company_id         Int
  item_id            Int
  good_receipt_id    Int?
  adjustment_case_id Int?
  quantity           Decimal @db.Decimal(36, 6)

  item            item             @relation(fields: [item_id], references: [id])
  good_receipt    good_receipt?    @relation(fields: [good_receipt_id], references: [id])
  adjustment_case adjustment_case? @relation(fields: [adjustment_case_id], references: [id])
}

model stock_out_distribution {
  id                 Int     @id
  company_id         Int
  item_id            Int
  bill_id            Int?
  adjustment_case_id Int?
  quantity           Decimal @db.Decimal(36, 6)
  value              Decimal @db.Decimal(36, 6)
  value_out          Decimal @db.Decimal(36, 0)

  company         company          @relation(fields: [company_id], references: [id])
  item            item             @relation(fields: [item_id], references: [id])
  adjustment_case adjustment_case? @relation(fields: [adjustment_case_id], references: [id])
  bill            bill?            @relation(fields: [bill_id], references: [id])
}
