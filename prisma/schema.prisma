  stock_in                stock_in?             @relation(fields: [stock_in_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "stock_out_ibfk_6")
  price                   Decimal               @db.Decimal(12, 2)
}

model stock_card {
  id               Int      @id @default(autoincrement())
  product_id       Int
  product_unit_id  Int?
  quantity         Decimal  @db.Decimal(12, 2)
  display_quantity Decimal  @db.Decimal(12, 2)
  date             DateTime @db.Date
  customer_id      Int?
  supplier_id      Int?
  document_name    String?  @db.VarChar(100)
  stock            Decimal? @db.Decimal(12, 2)

  customer customer? @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "stock_card_ibfk_1")
  supplier supplier? @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "stock_card_ibfk_2")

  sales_invoice_id      Int?
  sales_invoice         sales_invoice?      @relation(fields: [sales_invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "stock_card_ibfk_3")
  sales_invoice_code_id Int?
  sales_invoice_code    sales_invoice_code? @relation(fields: [sales_invoice_code_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "stock_card_ibfk_4")

  adjustment_case_id      Int?
  adjustment_case         adjustment_case?      @relation(fields: [adjustment_case_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "stock_card_ibfk_5")
  adjustment_case_code_id Int?
  adjustment_case_code    adjustment_case_code? @relation(fields: [adjustment_case_code_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "stock_card_ibfk_6")

  good_receipt_id      Int?
  good_receipt         good_receipt?      @relation(fields: [good_receipt_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "stock_card_ibfk_7")
  good_receipt_code_id Int?
  good_receipt_code    good_receipt_code? @relation(fields: [good_receipt_code_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "stock_card_ibfk_8")

  sales_return_id      Int?
  sales_return         sales_return?      @relation(fields: [sales_return_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "stock_card_ibfk_10")
  sales_return_code_id Int?
  sales_return_code    sales_return_code? @relation(fields: [sales_return_code_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "stock_card_ibfk_11")

  product      product       @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_unit product_unit? @relation(fields: [product_unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  created_at DateTime @db.DateTime(0)
}

model notification {
  id         Int      @id @default(autoincrement())
  created_by Int
  created_at DateTime @default(now()) @db.DateTime(0)
  title      String   @db.VarChar(100)
  message    String   @db.Text

  // user relation
  user_notification_created_byTouser user @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "notification_ibfk_1")
}

model overpayment {
  id                    Int      @id @default(autoincrement())
  customer_id           Int?
  date                  DateTime
  payment_method_id     Int?
  sales_deposit_code_id Int?
  return_payment_method String
  return_payment_number String?
  return_payment_date   DateTime
  return_payment_bank   String?
  return_payment_name   String
  created_by            Int
  created_at            DateTime @default(now()) @db.DateTime(0)
  is_resolved           Boolean  @default(false)
  value                 Decimal  @db.Decimal(12, 2)

  payment_method                    payment_method?     @relation(fields: [payment_method_id], references: [id])
  customer                          customer?           @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "overpayment_code_ibfk1")
  sales_deposit_code                sales_deposit_code? @relation(fields: [sales_deposit_code_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "overpayment_code_ibfk3")
  user_overpayment_created_byTouser user                @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "overpayment_code_ibfk4")
}

/// Jejak audit seluruh sistem.
///
/// Dicatat otomatis oleh middleware Prisma di database.helper.ts, bukan oleh
/// controller — jalur tulis yang lupa dipasangi pencatat tidak akan pernah
/// ketahuan karena tidak menimbulkan galat apa pun.
model audit_log {
  id        Int      @id @default(autoincrement())
  entity    String   @db.VarChar(64)
  entity_id Int?
  action    String   @db.VarChar(16)
  user_id   Int?
  changes   Json?
  note      String?  @db.VarChar(255)
  // 45 karakter: cukup untuk IPv6 penuh, termasuk bentuk ::ffff:1.2.3.4.
  ip        String?  @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  user user? @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "audit_log_ibfk_1")

  @@index([user_id], map: "audit_log_ibfk_1_idx")
  @@index([entity, entity_id], map: "audit_log_entity_idx")
  @@index([createdAt], map: "audit_log_created_at_idx")
}

/// Pengembalian diskon berupa uang kepada pelanggan.
///
/// Toko sering memberi diskon bukan dengan memotong harga di faktur, melainkan
/// dengan MENGEMBALIKAN uangnya — cash di kasir atau transfer. Fakturnya tetap
/// menunjukkan harga penuh, sebab itulah yang dilihat pemberi kerja si pembeli.
/// Selama uang keluar itu tidak dicatat, kas sore hari selalu kurang dibanding
/// laporan, dan selisihnya tidak bisa dijelaskan.
///
/// TABEL SENDIRI, BUKAN KOLOM DI sales_invoice_code. Nilainya TIDAK BOLEH
/// mengurangi total faktur — begitu ia menjadi kolom diskon, angka yang tercetak
/// ikut turun dan seluruh gunanya hilang. Yang dicatat di sini adalah arus kas
/// keluar yang kebetulan terikat pada sebuah faktur.
model sales_invoice_rebate {
  id                    Int      @id @default(autoincrement())
  sales_invoice_code_id Int
  value                 Decimal  @db.Decimal(15, 4)
  /// Cash atau transfer; mengikuti daftar metode pembayaran yang sudah ada.
  payment_method_id     Int?
  /// Tanggal uangnya keluar — menentukan laporan kas hari mana ia masuk.
  date                  DateTime @db.Date
  /// Siapa yang menerima uangnya. Inilah yang membuat selisih kas bisa ditelusuri.
  receiver_name         String   @db.VarChar(100)
  /// Diisi hanya bila dikembalikan lewat transfer.
  bank_name             String?  @db.VarChar(100)
  account_number        String?  @db.VarChar(50)
  created_by            Int
  created_at            DateTime @default(now()) @db.DateTime(0)

  sales_invoice_code sales_invoice_code @relation(fields: [sales_invoice_code_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sales_invoice_rebate_ibfk_1")
  payment_method     payment_method?    @relation(fields: [payment_method_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sales_invoice_rebate_ibfk_2")
  user               user               @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sales_invoice_rebate_ibfk_3")

  @@index([sales_invoice_code_id], map: "sales_invoice_rebate_ibfk_1_idx")
  @@index([payment_method_id], map: "sales_invoice_rebate_ibfk_2_idx")
  @@index([created_by], map: "sales_invoice_rebate_ibfk_3_idx")
}
